<dialog class="booking" data-booking aria-labelledby="booking-title">
  <div class="booking-backdrop" data-book-close></div>
  <section class="booking-panel">
    <div class="booking-head">
      <div>
        <p class="eyebrow">Finca Luna Nueva</p>
        <h2 id="booking-title">Tu estancia,<br />más cerca.</h2>
      </div>
      <button class="booking-close" type="button" data-book-close aria-label="Cerrar reserva">Cerrar <span>×</span></button>
    </div>

    <form class="booking-form" data-book-form>
      <label>
        <span>Llegada</span>
        <input type="date" name="arrival" required />
      </label>
      <label>
        <span>Salida</span>
        <input type="date" name="departure" required />
      </label>
      <label>
        <span>Huéspedes</span>
        <select name="guests" aria-label="Número de huéspedes">
          <option value="1">1 huésped</option>
          <option value="2" selected>2 huéspedes</option>
          <option value="3">3 huéspedes</option>
          <option value="4">4 huéspedes</option>
        </select>
      </label>
      <button class="booking-submit" type="submit">Consultar disponibilidad <span>↗</span></button>
    </form>
    <p class="booking-note" data-book-note>Confirmación directa · Mejor tarifa disponible</p>
  </section>
</dialog>
