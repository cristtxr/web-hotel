---
interface Props {
  active: 'home' | 'stay' | 'experience' | 'place';
}
const { active } = Astro.props;
---

<header class="site-header" data-site-header>
  <a class="wordmark" href="/" aria-label="Finca Luna Nueva — volver al lobby" data-cursor="Volver">
    <span class="wordmark-mark" aria-hidden="true">LN</span>
    <span>Finca Luna Nueva</span>
  </a>

  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav">
    <span>Menú</span><i></i>
  </button>

  <nav id="main-nav" class="main-nav" aria-label="Navegación principal">
    <a href="/stay" aria-current={active === 'stay' ? 'page' : undefined} data-prefetch-route="/stay">Stay</a>
    <a href="/experience" aria-current={active === 'experience' ? 'page' : undefined} data-prefetch-route="/experience">Experience</a>
    <a href="/place" aria-current={active === 'place' ? 'page' : undefined} data-prefetch-route="/place">The place</a>
  </nav>

  <button class="header-book" type="button" data-book-open>Reservar</button>
</header>
